{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Remote Attach",
            "type": "python",
            "request": "attach",
            "port": 5678,
            "host": "localhost",
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "vscode-notebook-cell:/c%3A/Users/Gabriella/Documents/NeedleGuide"
                }
            ]
        },
        {
            "name": "Python Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Prepare Data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/prepare_data.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--input_dir", "C:\\Users\\Gabriella\\Documents\\KidneyDataset\\Export_data",
                "--output_dir", "C:\\Users\\Gabriella\\Documents\\KidneyDataset\\Prepared_data",
                "--config_file", "${workspaceFolder}/scripts/prepare_data_config.yaml",
                "--log_level", "INFO",
                "--log_file", "prepare_data.log"
            ]
        },
        {
            "name": "Convert to Slices",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/convert_to_slices.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--data-folder", "C:\\Users\\Gabriella\\Documents\\KidneyDataset\\Prepared_data",
                "--output-dir", "C:\\Users\\Gabriella\\Documents\\KidneyDataset\\Slices",
                "--label-output", "preserve-input",
                "--overlap-policy", "priority",
                "--log_file", "convert_to_slices.log"
            ]
        }
    ]
}